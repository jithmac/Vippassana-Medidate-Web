generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String
  country          String   @default("")
  address          String   @default("")
  idPassportNumber String   @unique
  phoneNumber      String
  role             String   @default("STUDENT") // STUDENT, TEACHER, ADMIN
  personalInfo     String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications     Application[]
  enrollments      CourseEnrollment[]
  reviews          Review[] @relation("Reviewer")
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  courseId      String?
  course        CourseSchedule?   @relation(fields: [courseId], references: [id])
  courseType    String            // TEN_DAY, TWENTY_DAY, THIRTY_DAY, DHAMMA_SEWA

  // Section 1: Personal Info
  personalInfo  String            @default("{}") // Stored as JSON string

  // Section 2: Medical Info
  medicalInfo   String            @default("{}")

  // Section 3: Family Info (NEW)
  familyInfo    String            @default("{}")

  // Section 4: Occupational Info
  occupationalInfo String         @default("{}")

  // Section 5: Course History
  courseHistory String            @default("[]")

  // Routing
  previousTeacherId  String?
  newTeacherId       String?
  areaTeacherId      String?
  currentReviewStage String? // PENDING_PREVIOUS, PENDING_NEW, PENDING_AREA, COMPLETED

  // Meta
  status        String            @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  submittedAt   DateTime?
  pdfDownloaded Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  reviews       Review[]
}

model CourseEnrollment {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  courseType      String         // TEN_DAY, etc.
  completedAt     DateTime?      
  attendanceData  String?        @default("{}") // Stored as JSON string
  completionReview String?       
  createdAt       DateTime       @default(now())
}

model Review {
  id             String         @id @default(cuid())
  applicationId  String
  application    Application    @relation(fields: [applicationId], references: [id])
  reviewerId     String?
  reviewer       User?          @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewerRole   String         // NEW_TEACHER, PREVIOUS_TEACHER, AREA_TEACHER
  decision       String?        // APPROVED, REJECTED, NEEDS_INFO
  remarks        String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
}

model CourseSchedule {
  id          String   @id @default(cuid())
  courseType  String   // TEN_DAY, etc.
  stage       Int      @default(1)
  teacherId   String?
  centerName  String
  startDate   String
  endDate     String
  capacity    Int      @default(100)
  enrolled    Int      @default(0)
  status      String   @default("OPEN") // OPEN, FULL, COMPLETED
  itemsToBring String  @default("White clothing, personal toiletries, meditation cushion")
  createdAt   DateTime @default(now())

  applications Application[]
}

model SmsLog {
  id          String   @id @default(cuid())
  phone       String
  message     String
  status      String   @default("SENT")
  createdAt   DateTime @default(now())
}
